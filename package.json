    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "exceljs": "4.4.0",
    "isomorphic-dompurify": "^3.3.0",
    "lucide-react": "^0.577.0",
    "mime-types": "^3.0.2",
    "next": "15.5.14",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",

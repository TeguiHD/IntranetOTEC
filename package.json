    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.71.2",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "validator": "^13.15.26",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },

{
  "name": "otec",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "quality:gate": "node scripts/quality-gate.mjs",
    "security:test": "rm -rf .security-build && tsc -p tsconfig.security-tests.json && mkdir -p .security-build/node_modules/@ && ln -sfn ../../src/lib .security-build/node_modules/@/lib && node --test .security-build/security-tests/*.security.test.js",
    "security:validate": "pnpm quality:gate && pnpm security:test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",

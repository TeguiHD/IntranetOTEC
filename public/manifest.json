{
  "id": "/?app=mi-otec",
  "name": "Mi OTEC Intranet",
  "short_name": "Mi OTEC",
  "description": "Intranet educativa de Mi OTEC para alumnos, docentes y administracion.",
  "start_url": "/login?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0b0610",
  "theme_color": "#5a1f68",
  "orientation": "any",
  "categories": ["education", "productivity"],
  "lang": "es-CL",
  "dir": "ltr",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "shortcuts": [
    {
      "name": "Panel",
      "short_name": "Panel",
      "description": "Abrir panel principal",
      "url": "/login?source=pwa-shortcut",
      "icons": [{ "src": "/icon-192-v2.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Mis cursos",
      "short_name": "Cursos",
      "description": "Abrir cursos del alumno",
      "url": "/alumno/asignaturas?source=pwa-shortcut",
      "icons": [{ "src": "/icon-192-v2.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Materiales",
      "short_name": "Materiales",
      "description": "Abrir material de apoyo",
      "url": "/docente/materiales?source=pwa-shortcut",
      "icons": [{ "src": "/icon-192-v2.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    { "src": "/icon-72-v2.png",  "sizes": "72x72",   "type": "image/png" },
    { "src": "/icon-96-v2.png",  "sizes": "96x96",   "type": "image/png" },
    { "src": "/icon-128-v2.png", "sizes": "128x128", "type": "image/png" },
    { "src": "/icon-144-v2.png", "sizes": "144x144", "type": "image/png" },
    { "src": "/icon-152-v2.png", "sizes": "152x152", "type": "image/png" },
    { "src": "/icon-192-v2.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-384-v2.png", "sizes": "384x384", "type": "image/png" },
    { "src": "/icon-512-v2.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-192-maskable-v2.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-512-maskable-v2.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
